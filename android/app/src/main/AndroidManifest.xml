<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to hold the low-latency Wi-Fi lock while the pad is on screen -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Pad Controller"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- singleTask + configChanges: never recreate the activity, so the UDP session survives. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
